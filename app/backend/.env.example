APP_MODE=demo_free
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Modern server-only sb_secret_ keys also work under this alias.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SESSION_ENCRYPTION_KEY=
DOCUMENT_ENCRYPTION_KEY=
# Local only: false. Hosted environments must use true.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
EMAIL_AUTH_ENABLED=false
DOCUMENT_BUCKET=kerja-private
# Operator scripts only; never expose this to Vercel/browser.
DATABASE_URL=
EXTERNAL_LLM_ENABLED=false
ALLOW_PAID_PROVIDERS=false
LLM_PROVIDER=openrouter
MORPHEUS_API_KEY=
MORPHEUS_BASE_URL=https://api.mor.org/api/v1
MORPHEUS_MODEL=gpt-oss-120b
MORPHEUS_MAX_TOKENS=256
MORPHEUS_TIMEOUT_SECONDS=15
OUTBOUND_EMAIL_ENABLED=false

# M3 defaults: synthetic identity documents only. Real capture also needs DB policy/legal approval.
IDENTITY_REAL_ENABLED=false

# M4 uses deterministic grading/offline private reports; no new service/model key.
# New-start switches live in server-only kerja_private.quiz_policy (docs/m4/SETUP.md).

# M5 mock/manual workflow: no official provider keys or portal credentials.
# Real report capture stays off; DB dispatch/activation policy documented in docs/m5.

# M6: optional public FAQ variant selector only; never send candidate records.
# Keep disabled until exact provider zero pricing and privacy compatibility are verified.
OPENROUTER_API_KEY=
M6_OPENROUTER_PROVIDER=
M6_EXTERNAL_PRIVACY_APPROVED=false
# DB chat_policy must also explicitly enable external requests/privacy approval.

# M7 network worker off until source terms/redistribution/robots approval + DB enablement.
JOB_DISCOVERY_ENABLED=false
SCRAPLING_ENABLED=false
# No JobSpy/LinkedIn cookies/paid proxies/agent-reach runtime integration.

# M9: synthetic demo release only; configure a monitored address before public use.
PRIVACY_CONTACT=
# Real-data/pilot/commercial release remains gated; account-erasure requests need operator review.

# M10: pause API/UI actions without disabling retention cleanup.
TRACKER_ENABLED=true

# M11 descriptive analytics; false pauses reads/exports.
ANALYTICS_ENABLED=true

# M12 owner-only reminders: all external dispatch off until reviewed activation.
REMINDER_WORKER_ENABLED=false
REMINDER_SENDER=disabled
REMINDER_EMAIL_APPROVED=false
REMINDER_FREE_SMTP_APPROVED=false
# Reuse existing verified SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD.
# SMTP_FROM must equal the verified SMTP_USER for the reminder adapter.
SMTP_FROM=

# Local sample-data agent preview only; never enable for hosted accounts.
DEMO_PREVIEW_ENABLED=false
